+
+TEST_CASE("Publication batches preserve prefix boundaries and reject invalidated reads",
+          "[judgement][publication][batch]") {
+    PublicationFixture fixture;
+    auto session = fixture.session();
+    REQUIRE(session.advance(Tick{1103}));
+    auto view = read(session);
+    const auto metadata = view.metadata();
+    REQUIRE(metadata);
+    const auto end = metadata->get().publishableCursor;
+    REQUIRE(end > 0);
+    for (const std::size_t width : {std::size_t{1}, std::size_t{3}, std::size_t{64}}) {
+        std::array<detail::PublicationFact, 64> batch{};
+        std::uint64_t ordinal{};
+        while (ordinal < end) {
+            auto count = view.readFacts(ordinal, std::span{batch}.first(width));
+            REQUIRE(count);
+            REQUIRE(*count > 0);
+            REQUIRE(*count <= width);
+            REQUIRE(*count <= end - ordinal);
+            for (std::size_t i = 0; i < *count; ++i) {
+                const auto single = view.fact(ordinal + i);
+                REQUIRE(single);
+                CHECK(batch[i].kind == single->kind);
+                CHECK(batch[i].factId == single->factId);
+                CHECK(batch[i].requirement == single->requirement);
+                CHECK(batch[i].phase == single->phase);
+                CHECK(batch[i].outcome == single->outcome);
+                CHECK(batch[i].error == single->error);
+            }
+            ordinal += *count;
+        }
+    }
+    std::array<detail::PublicationFact, 3> batch{};
+    CHECK(view.readFacts(end, batch).value() == 0);
+    CHECK(view.readFacts(0, {}).value() == 0);
+    CHECK_FALSE(view.readFacts(UINT64_MAX, batch));
+    bool rejected{};
+    std::thread foreign([&] { rejected = !view.readFacts(0, batch); });
+    foreign.join();
+    CHECK(rejected);
+    REQUIRE(session.submit({}));
+    CHECK_FALSE(view.readFacts(0, batch));
+    {
+        auto tail = read(session, end);
+        CHECK_FALSE(tail.readFacts(end - 1, batch));
+        CHECK(tail.readFacts(end, batch).value() == 0);
+    }
+    std::optional<detail::PublicationRead> dead;
+    {
+        auto temporary = fixture.session();
+        REQUIRE(temporary.advance(Tick{1103}));
+        dead.emplace(read(temporary));
+    }
+    CHECK_FALSE(dead->readFacts(0, batch));
+}
