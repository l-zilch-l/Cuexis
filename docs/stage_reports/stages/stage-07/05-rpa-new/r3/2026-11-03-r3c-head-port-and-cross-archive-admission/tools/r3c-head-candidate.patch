+TEST_CASE("R3c cross generation admission republishes inherited branch index", "[r3c-cross]") {
+    Fixture3 f;
+    expandTickFixture(f, 1536, 256);
+    auto made = detail::ExecutionKernel::prepare(f.configuration(), f.prepared());
+    REQUIRE(made);
+    REQUIRE((*made)->advance(Tick{1504}));
+    const auto archive = (*made)->archive();
+    const auto points = detail::ExecutionKernel::tickPointCount(archive);
+    const auto admitted = detail::ExecutionKernel::tickPayloadAdmittedBytes(archive);
+    REQUIRE(points > 1);
+    REQUIRE(admitted > 0);
+    const auto cut = replayCutAt(archive, Tick{1504});
+    auto branch = detail::ExecutionKernel::seekCandidate(archive, Tick{1504}, nullptr, &cut);
+    REQUIRE(branch);
+    // Before divergence the branch republishes the source generation through its own admission.
+    const auto inherited = (*branch)->archive();
+    CHECK(detail::ExecutionKernel::tickPointCount(inherited) == points);
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(inherited) == admitted);
+    CHECK(detail::ExecutionKernel::tickAdmissionRefused(inherited) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(inherited) ==
+          detail::ExecutionKernel::tickPayloadBytes(archive));
+    // After divergence the branch seals its own journal and admits only its own slots.
+    REQUIRE((*branch)->advance(Tick{1704}));
+    auto diverged = (*branch)->archive();
+    CHECK(diverged.anchor() != archive.anchor());
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(diverged) > 0);
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(diverged) <=
+          detail::ExecutionKernel::tickPayloadBytes(diverged));
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(diverged) <=
+          detail::ExecutionKernel::tickPayloadLimit(diverged));
+    branch->reset();
+    diverged = archive;
+    made->reset();
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(archive) == admitted);
+}
