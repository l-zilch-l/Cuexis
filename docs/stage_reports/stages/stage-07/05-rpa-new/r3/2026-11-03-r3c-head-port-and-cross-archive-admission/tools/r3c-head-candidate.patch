+void expandTickFixture(Fixture3& f, unsigned count, unsigned wave = 0) {
+    f.rules = controlRules(false);
+    auto& doc = f.assembly.sources.front().document;
+    const auto prototype = doc.requirements.front();
+    doc.requirements.clear();
+    std::erase_if(doc.declarations,
+                  [](const auto& d) { return d.kind == DeclarationKind::requirement; });
+    doc.relations.front().members.clear();
+    f.assembly.contentProfileLimits.maxRequirements =
+        MeasuredParameter<std::uint64_t>::measured(count);
+    for (unsigned i = 0; i < count; ++i) {
+        auto r = prototype;
+        r.stableId.declarationOrdinal = 100 + i;
+        r.identity.requirementLocalId = "tick.prototype." + std::to_string(i);
+        r.resourceClaims.front().claimPolicy.competition =
+            ClaimPolicyDeclaration::CompetitionKey{-1, i};
+        if (wave) {
+            const auto shift = static_cast<std::int64_t>(i / wave) * 200;
+            auto moveTick = [shift](Tick& t) { t = Tick{t.value() + shift}; };
+            moveTick(r.timing->end);
+            for (auto& w : r.timing->successWindows) {
+                moveTick(w.start);
+                moveTick(w.end);
+            }
+            if (r.timing->body) {
+                moveTick(r.timing->body->start);
+                moveTick(r.timing->body->end);
+            }
+            for (auto& t : r.timing->phaseTargets)
+                moveTick(t.chartTick);
+        }
+        doc.declarations.push_back(
+            testDeclaration(DeclarationKind::requirement, r.identity.requirementLocalId, 100 + i));
+        doc.relations.front().members.push_back(r.stableId);
+        doc.requirements.push_back(std::move(r));
+    }
+}
