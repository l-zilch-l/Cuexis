+TEST_CASE("R3c cross generation admission keeps retained generations under the limit",
+          "[r3c-cross]") {
+    Fixture3 f;
+    expandTickFixture(f, 1536, 256);
+    const auto config = f.configuration();
+    const auto prepared = f.prepared();
+    auto calibrate = detail::ExecutionKernel::prepare(config, prepared);
+    REQUIRE(calibrate);
+    REQUIRE((*calibrate)->advance(Tick{904}));
+    const auto first = detail::ExecutionKernel::tickPayloadBytes((*calibrate)->archive());
+    REQUIRE(first > 0);
+    // Room for more than the four writer slots: old archives must keep evicted points alive
+    // and still stay inside the same preparation limit.
+    const auto limit = first * 12;
+    auto made = detail::ExecutionKernel::prepare(config, prepared);
+    REQUIRE(made);
+    REQUIRE((*made)->setTickPayloadLimitForProbe(limit));
+    auto empty = (*made)->archive();
+    CHECK(detail::ExecutionKernel::tickPayloadLimit(empty) == limit);
+    std::vector<ReplayArchive> generations;
+    std::size_t peak = 0;
+    for (const auto h : {904, 1104, 1304, 1504, 1704, 1904}) {
+        REQUIRE((*made)->advance(Tick{h}));
+        generations.push_back((*made)->archive());
+        const auto live = detail::ExecutionKernel::tickPayloadBytes(empty);
+        CHECK(live <= limit);
+        peak = std::max(peak, live);
+    }
+    CHECK(peak > detail::ExecutionKernel::tickPayloadAdmittedBytes(generations[0]));
+    CHECK(detail::ExecutionKernel::tickPointCount(generations.back()) > 1);
+    // Exact replay of every retained generation stays inside the same bound.
+    for (const auto& archive : generations) {
+        const ReplayArchive external{
+            archive.anchor(), std::make_shared<const RecoveryInputs>(archive.dependencies())};
+        for (const auto h : {904, 1504, 1904}) {
+            const auto cut = replayCutAt(archive, Tick{h});
+            auto a = detail::ExecutionKernel::seekCandidate(archive, Tick{h}, nullptr, &cut);
+            auto b = detail::ExecutionKernel::seekCandidate(external, Tick{h}, nullptr, &cut);
+            REQUIRE(a);
+            REQUIRE(b);
+            auto av = (*a)->snapshot();
+            auto bv = (*b)->snapshot();
+            REQUIRE(av);
+            REQUIRE(bv);
+            CHECK(sameSnapshot((*av)->dto, (*bv)->dto));
+            CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) <= limit);
+        }
+    }
+    made->reset();
+    generations.clear();
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == 0);
+}
