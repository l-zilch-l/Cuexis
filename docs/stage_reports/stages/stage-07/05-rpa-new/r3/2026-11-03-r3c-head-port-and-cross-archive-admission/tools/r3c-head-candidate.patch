+    // so an archive reports what its own index keeps alive, not the whole preparation lineage.
+    [[nodiscard]] auto bytes() const noexcept -> std::size_t {
+        auto total = std::size_t{};
+        for (std::size_t i = 0; i < count; ++i)
+            if (points[i])
+                total += points[i]->payload.charge();
+        return total;
+    }
+};
+
+// Cross-generation admission: an archive index accepts a point only while the point is charged to
+// the budget that the archive itself publishes. Points of a foreign or already released budget are
+// refused instead of being retained by an index that could not refund or account for them.
+// Refusal keeps the writer's own slots untouched; the lease is released when the writer drops it.
+inline auto admitTickPoints(const TickPoints& source,
+                            const std::shared_ptr<const TickPayloadBudget>& owner,
+                            TickPoints& admitted) noexcept -> std::size_t {
+    admitted = {};
+    if (!owner)
+        return 0;
+    for (std::size_t i = 0; i < source.count; ++i) {
+        const auto& point = source.points[i];
+        if (!point || point->payload.owner() != owner)
+            continue;
+        admitted.points[admitted.count++] = point;
+    }
+    return admitted.bytes();
+}
