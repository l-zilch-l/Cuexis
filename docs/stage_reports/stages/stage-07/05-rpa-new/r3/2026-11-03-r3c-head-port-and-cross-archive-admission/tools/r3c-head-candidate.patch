+TEST_CASE("R3c cross generation admission reports each archive own payload", "[r3c-cross]") {
+    Fixture3 f;
+    expandTickFixture(f, 1536, 256);
+    auto made = detail::ExecutionKernel::prepare(f.configuration(), f.prepared());
+    REQUIRE(made);
+    auto writer = std::move(*made);
+    auto empty = writer->archive();
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(empty) == 0);
+    CHECK(detail::ExecutionKernel::tickAdmissionRefused(empty) == 0);
+    std::vector<ReplayArchive> generations;
+    for (const auto h : {904, 1104, 1304, 1504, 1704, 1904}) {
+        REQUIRE(writer->advance(Tick{h}));
+        generations.push_back(writer->archive());
+    }
+    std::size_t previous = 0;
+    for (const auto& archive : generations) {
+        const auto points = detail::ExecutionKernel::tickPointCount(archive);
+        const auto admitted = detail::ExecutionKernel::tickPayloadAdmittedBytes(archive);
+        const auto live = detail::ExecutionKernel::tickPayloadBytes(archive);
+        INFO(points << " " << admitted << " " << live);
+        REQUIRE(points > 0);
+        REQUIRE(points <= kTickSlots);
+        CHECK(admitted > 0);
+        CHECK(admitted >= previous);
+        CHECK(admitted <= live);
+        CHECK(live <= detail::ExecutionKernel::tickPayloadLimit(archive));
+        CHECK(detail::ExecutionKernel::tickAdmissionRefused(archive) == 0);
+        previous = admitted;
+    }
+    const auto liveBefore = detail::ExecutionKernel::tickPayloadBytes(empty);
+    const auto firstAdmitted = detail::ExecutionKernel::tickPayloadAdmittedBytes(generations[0]);
+    CHECK(liveBefore > firstAdmitted);
+    generations[0] = empty;
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == liveBefore);
+    writer.reset();
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == liveBefore);
+    generations[1] = empty;
+    generations[2] = empty;
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == liveBefore);
+    generations.clear();
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(empty) == 0);
+}
