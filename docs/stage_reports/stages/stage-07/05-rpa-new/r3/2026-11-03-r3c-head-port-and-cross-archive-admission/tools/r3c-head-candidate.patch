+TEST_CASE("R3c append only floor requires shared complete pages and charges partial tail",
+          "[r3c-budget]") {
+    detail::SharedSequence<std::uint64_t> original;
+    for (std::uint64_t i = 0; i < 130; ++i)
+        original.push_back(i);
+    auto later = original;
+    std::size_t full = 0, retained = 0;
+    original.visitStorageCapacity([&](auto n, auto width) { full += n * width; });
+    const auto first =
+        original.visitAppendOnlyRetention([&](auto n, auto width) { retained += n * width; });
+    CHECK(first == 128);
+    CHECK(retained < full);
+    later.push_back(130);
+    CHECK(original.sharesCompletePrefixPagesWith(later));
+    later.update(129, [](auto& x) { x = 900; });
+    CHECK(original.sharesCompletePrefixPagesWith(later));
+    later.update(1, [](auto& x) { x = 901; });
+    CHECK_FALSE(original.sharesCompletePrefixPagesWith(later));
+    detail::SharedSequence<std::uint64_t> sameValues;
+    for (std::uint64_t i = 0; i < 130; ++i)
+        sameValues.push_back(i);
+    CHECK_FALSE(original.sharesCompletePrefixPagesWith(sameValues));
+    CHECK_FALSE(original.sharesCompletePrefixPagesWith({}));
+    detail::SharedSequence<std::uint64_t> empty;
+    CHECK(empty.sharesCompletePrefixPagesWith(original));
+    CHECK(empty.visitAppendOnlyRetention([](auto, auto) {}) == 0);
+    detail::SharedSequence<std::uint64_t> exact;
+    for (std::uint64_t i = 0; i < 128; ++i)
+        exact.push_back(i);
+    CHECK(exact.visitAppendOnlyRetention([](auto, auto) {}) == 128);
+    auto saved = original;
+    std::size_t reentrant = 0;
+    CHECK(original.visitAppendOnlyRetention([&](auto n, auto width) {
+        reentrant += n * width;
+        original.clear();
+        original.push_back(7);
+    }) == 128);
+    CHECK(reentrant == retained);
+    CHECK(saved.size() == 130);
+}
