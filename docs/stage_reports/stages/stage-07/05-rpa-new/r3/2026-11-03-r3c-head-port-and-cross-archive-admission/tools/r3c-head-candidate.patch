+TEST_CASE("R3c accounting diagnostic", "[.][r3c-accounting]") {
+    std::string barrier;
+    REQUIRE(static_cast<bool>(std::getline(std::cin, barrier)));
+    const auto size = cuexis::test_support::environmentVariable("R3C_ACCOUNTING_N");
+    REQUIRE_FALSE(size.empty());
+    const auto n = static_cast<unsigned>(std::stoul(size));
+    const auto waveValue = cuexis::test_support::environmentVariable("R3C_ACCOUNTING_WAVE");
+    const auto wave =
+        !waveValue.empty() ? static_cast<unsigned>(std::stoul(waveValue)) : (n == 1536 ? 256U : 0U);
+    const auto limitValue = cuexis::test_support::environmentVariable("R3C_ACCOUNTING_LIMIT_MIB");
+    const auto limitMib = !limitValue.empty() ? static_cast<unsigned>(std::stoul(limitValue)) : 0U;
+    const auto captureValue = cuexis::test_support::environmentVariable("R3C_ACCOUNTING_CAPTURE");
+    const bool capture = captureValue.empty() || std::string_view{captureValue} != "0";
+    // Stepwise mode: every printed line is followed by a barrier so an external sampler can read
+    // the process at that exact point instead of racing the whole run.
+    const bool stepwise = !cuexis::test_support::environmentVariable("R3C_ACCOUNTING_STEP").empty();
+    const auto visit = [stepwise] {
+        if (stepwise) {
+            std::string step;
+            REQUIRE(static_cast<bool>(std::getline(std::cin, step)));
+        }
+    };
+    Fixture3 f;
+    expandTickFixture(f, n, wave);
+    const auto config = f.configuration();
+    const auto prepared = f.prepared();
+    auto made = detail::ExecutionKernel::prepare(config, prepared);
+    REQUIRE(made);
+    std::optional<ReplayArchive> probe;
+    if (limitMib) {
+        // Quota probe: only a quiescent preparation may retune its own admission limit.
+        REQUIRE((*made)->setTickPayloadLimitForProbe(static_cast<std::size_t>(limitMib) << 20));
+    }
+    probe.emplace((*made)->archive());
+    std::vector<ReplayArchive> generations;
+    for (const auto h : {904, 1104, 1304, 1504, 1704, 1904}) {
+        const auto advanced =
+            capture ? (*made)->advance(Tick{h}) : (*made)->advanceForReplay(Tick{h});
+        REQUIRE(advanced);
+        generations.push_back((*made)->archive());
+        const auto& archive = generations.back();
+        std::cout << "{\"event\":\"r3c.accounting\",\"n\":" << n << ",\"wave\":" << wave
+                  << ",\"capture\":" << (capture ? 1 : 0) << ",\"horizon\":" << h
+                  << ",\"points\":" << detail::ExecutionKernel::tickPointCount(archive)
+                  << ",\"admitted_bytes\":"
+                  << detail::ExecutionKernel::tickPayloadAdmittedBytes(archive)
+                  << ",\"live_bytes\":" << detail::ExecutionKernel::tickPayloadBytes(archive)
+                  << ",\"limit\":" << detail::ExecutionKernel::tickPayloadLimit(archive)
+                  << ",\"refused\":" << detail::ExecutionKernel::tickAdmissionRefused(archive)
+                  << "}" << std::endl;
+        visit();
+    }
+    made->reset();
+    std::cout << "{\"event\":\"r3c.accounting_release\",\"n\":" << n << ",\"wave\":" << wave
+              << ",\"live_bytes\":" << detail::ExecutionKernel::tickPayloadBytes(*probe) << "}"
+              << std::endl;
+    visit();
+    generations.clear();
+    std::cout << "{\"event\":\"r3c.accounting_final\",\"n\":" << n << ",\"wave\":" << wave
+              << ",\"live_bytes\":" << detail::ExecutionKernel::tickPayloadBytes(*probe) << "}"
+              << std::endl;
+    // Optional second barrier: lets an external sampler read the process after every owner is
+    // released, without keeping any measurement code inside the product test.
+    if (!cuexis::test_support::environmentVariable("R3C_ACCOUNTING_HOLD").empty()) {
+        std::string released;
+        REQUIRE(static_cast<bool>(std::getline(std::cin, released)));
+    }
+}
