+TEST_CASE("R3c unsealed and independent archives admit no payload", "[r3c-cross]") {
+    Fixture3 f;
+    expandTickFixture(f, 256);
+    auto made = detail::ExecutionKernel::prepare(f.configuration(), f.prepared());
+    REQUIRE(made);
+    REQUIRE((*made)->advance(Tick{1203}));
+    const auto archive = (*made)->archive();
+    REQUIRE(detail::ExecutionKernel::tickPointCount(archive) > 0);
+    const ReplayArchive external{archive.anchor(),
+                                 std::make_shared<const RecoveryInputs>(archive.dependencies())};
+    CHECK(detail::ExecutionKernel::tickPointCount(external) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(external) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(external) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadLimit(external) == 0);
+    const auto wire = encodeReplay(archive);
+    REQUIRE(wire);
+    auto decoded = decodeReplay(*wire, archive.dependencies());
+    REQUIRE(decoded);
+    const auto replayCut = replayCutAt(*decoded, Tick{1303});
+    auto replayed =
+        detail::ExecutionKernel::seekCandidate(*decoded, Tick{1303}, nullptr, &replayCut);
+    REQUIRE(replayed);
+    const auto independent = (*replayed)->archive();
+    CHECK(independent.anchor() != archive.anchor());
+    CHECK(detail::ExecutionKernel::tickPointCount(independent) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(independent) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(independent) == 0);
+    // A diagnostic-controlled writer never stages payload either.
+    auto controlled = detail::ExecutionKernel::prepare(f.configuration(), f.prepared());
+    REQUIRE(controlled);
+    REQUIRE((*controlled)->inject({}));
+    REQUIRE((*controlled)->advance(Tick{1203}));
+    const auto controlledArchive = (*controlled)->archive();
+    CHECK(detail::ExecutionKernel::tickPointCount(controlledArchive) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadAdmittedBytes(controlledArchive) == 0);
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(controlledArchive) == 0);
+}
