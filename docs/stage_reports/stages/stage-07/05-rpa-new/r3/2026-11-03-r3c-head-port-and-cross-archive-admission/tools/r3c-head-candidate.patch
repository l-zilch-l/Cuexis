+    auto empty = (*made)->archive();
+    REQUIRE((*made)->advance(Tick{2503}));
+    auto archive = (*made)->archive();
+    auto wire = encodeReplay(archive);
+    REQUIRE(wire);
+    auto independent = decodeReplay(*wire, archive.dependencies());
+    REQUIRE(independent);
+    CHECK(independent->anchor() != archive.anchor());
+    std::weak_ptr<const ReplayData> original = archive.anchor();
+    const auto cut = replayCutAt(archive, Tick{1504});
+    auto branch = detail::ExecutionKernel::seekCandidate(archive, Tick{1504}, nullptr, &cut);
+    REQUIRE(branch);
+    auto expected = detail::ExecutionKernel::seekCandidate(*independent, Tick{1504}, nullptr, &cut);
+    REQUIRE(expected);
+    made->reset();
+    archive = empty;
+    CHECK_FALSE(original.expired());
+    REQUIRE((*branch)->advance(Tick{2504}));
+    CHECK(original.expired());
+    REQUIRE((*expected)->advanceForReplay(Tick{2504}));
+    auto a = (*branch)->snapshot();
+    auto b = (*expected)->snapshot();
+    REQUIRE(a);
+    REQUIRE(b);
+    CHECK(sameSnapshot((*a)->dto, (*b)->dto));
+    const auto av = (*branch)->archive();
+    const auto bv = (*expected)->archive();
+    CHECK(sameReplayHistory(av, bv));
+    auto aw = encodeReplay(av);
+    auto bw = encodeReplay(bv);
+    REQUIRE(aw);
+    REQUIRE(bw);
+    CHECK(*aw == *bw);
+}
