+    if (prefix == 4)
+        REQUIRE(writer->submitCanonical({occurrence(900, 0, InputAction::press)}));
+    REQUIRE(writer->advance(Tick{1203}));
+    auto archive = writer->archive();
+    REQUIRE(detail::ExecutionKernel::tickPointCount(archive) > 0);
+    const auto originalWire = encodeReplay(archive);
+    REQUIRE(originalWire);
+    const ReplayArchive external{archive.anchor(),
+                                 std::make_shared<const RecoveryInputs>(archive.dependencies())};
+    CHECK(detail::ExecutionKernel::tickPointCount(external) == 0);
+    writer.reset();
+    for (const auto h : {902, 904, 1003, 1103, 1203}) {
+        INFO(h);
+        const auto cut = replayCutAt(archive, Tick{h});
+        auto expected = detail::ExecutionKernel::seekCandidate(external, Tick{h}, nullptr, &cut);
+        auto actual = detail::ExecutionKernel::seekCandidate(archive, Tick{h}, nullptr, &cut);
+        REQUIRE(expected);
+        REQUIRE(actual);
+        CHECK((*actual)->tickRestoreCount() == (h >= 904 && h < 1203 ? 1 : 0));
+        auto a = (*actual)->snapshot();
+        auto b = (*expected)->snapshot();
+        REQUIRE(a);
+        REQUIRE(b);
+        CHECK(sameSnapshot((*a)->dto, (*b)->dto));
+        const auto av = detail::KernelTestAccess::snapshotValue((*a)->dto, archive.dependencies());
+        const auto bv = detail::KernelTestAccess::snapshotValue((*b)->dto, archive.dependencies());
+        auto aw = encodeSnapshot(av);
+        auto bw = encodeSnapshot(bv);
+        REQUIRE(aw);
+        REQUIRE(bw);
+        CHECK(*aw == *bw);
+        if (prefix == 4) {
+            REQUIRE((*actual)->submitCanonical({occurrence(1300, 1, InputAction::release)}));
+            REQUIRE((*expected)->submitCanonical({occurrence(1300, 1, InputAction::release)}));
+        }
+        REQUIRE((*actual)->advance(Tick{1303}));
+        REQUIRE((*expected)->advance(Tick{1303}));
+        a = (*actual)->snapshot();
+        b = (*expected)->snapshot();
+        REQUIRE(a);
+        REQUIRE(b);
+        CHECK(sameSnapshot((*a)->dto, (*b)->dto));
+        const auto actualBranch = (*actual)->archive();
+        const auto expectedBranch = (*expected)->archive();
+        CHECK(sameReplayHistory(actualBranch, expectedBranch));
+        const auto actualReplayWire = encodeReplay(actualBranch);
+        const auto expectedReplayWire = encodeReplay(expectedBranch);
+        REQUIRE(actualReplayWire);
+        REQUIRE(expectedReplayWire);
+        CHECK(*actualReplayWire == *expectedReplayWire);
+    }
+    auto finalWire = encodeReplay(archive);
+    REQUIRE(finalWire);
+    CHECK(*finalWire == *originalWire);
+}
