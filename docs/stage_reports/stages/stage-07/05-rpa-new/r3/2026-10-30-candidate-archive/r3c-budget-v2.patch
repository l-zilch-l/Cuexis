+TEST_CASE("R3c ordinary writer capture diagnostic", "[r3c-writer]") {
+    std::string barrier;
+    REQUIRE(static_cast<bool>(std::getline(std::cin, barrier)));
+    const auto size = cuexis::test_support::environmentVariable("R3_WRITER_N");
+    const auto mode = cuexis::test_support::environmentVariable("R3_WRITER_CAPTURE");
+    const auto waveValue = cuexis::test_support::environmentVariable("R3_WRITER_WAVE");
+    REQUIRE_FALSE(size.empty());
+    REQUIRE_FALSE(mode.empty());
+    const auto n = static_cast<unsigned>(std::stoul(size));
+    const auto wave = !waveValue.empty() ? static_cast<unsigned>(std::stoul(waveValue)) : 0;
+    const bool capture = std::string_view{mode} == "1";
+    Fixture3 f;
+    expandTickFixture(f, n, wave);
+    const auto config = f.configuration();
+    const auto prepared = f.prepared();
+    const Tick target{wave ? 2503 : 1203};
+    std::optional<SnapshotDTO> expected;
+    for (unsigned attempt = 0; attempt < 3; ++attempt) {
+        auto made = detail::ExecutionKernel::prepare(config, prepared);
+        REQUIRE(made);
+        const auto start = std::chrono::steady_clock::now();
+        auto result = capture ? (*made)->advance(target) : (*made)->advanceForReplay(target);
+        const auto end = std::chrono::steady_clock::now();
+        REQUIRE(result);
+        const auto archive = (*made)->archive();
+        const auto points = detail::ExecutionKernel::tickPointCount(archive);
+        CHECK(points == (capture ? (wave ? 4 : 1) : 0));
+        auto snapshot = (*made)->snapshot();
+        REQUIRE(snapshot);
+        if (expected)
+            CHECK(sameSnapshot(*expected, (*snapshot)->dto));
+        else
+            expected = (*snapshot)->dto;
+        std::cout << "{\"event\":\"r3c.writer\",\"n\":" << n << ",\"wave\":" << wave
+                  << ",\"capture\":" << capture << ",\"attempt\":" << attempt << ",\"advance_us\":"
+                  << std::chrono::duration<double, std::micro>(end - start).count()
+                  << ",\"points\":" << points << "}\n";
+    }
+    auto wire =
+        encodeSnapshot(detail::KernelTestAccess::snapshotValue(*expected, {config, prepared}));
+    REQUIRE(wire);
+    std::cout << "R3_WRITER_WIRE " << wire->size() << " " << cuexis::core::detail::sha256Hex(*wire)
+              << "\n";
+}
