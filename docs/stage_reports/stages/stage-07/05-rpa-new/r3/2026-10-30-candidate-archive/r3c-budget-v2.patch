+// Capacity accounting reuses the existing field traversal, not serialized byte length.
+// Unknown/error owners cannot acquire a charge. All shared pages are charged per point.
+class TickPayloadCounter final {
+    std::size_t total_{};
+    std::size_t limit_;
+    bool valid_{true};
+
+  public:
+    explicit TickPayloadCounter(std::size_t limit) noexcept : limit_(limit) {}
+    static constexpr std::uint32_t revision = 3;
+    void add(std::size_t count, std::size_t width) noexcept {
+        if (!valid_)
+            return;
+        if (width && count > (limit_ - total_) / width) {
+            valid_ = false;
+            return;
+        }
+        total_ += count * width;
+    }
+    auto bytes() const noexcept -> std::optional<std::size_t> {
+        return valid_ ? std::optional{total_} : std::nullopt;
+    }
+    template <class... T> void operator()(const T&... values) {
+        (dynamic(values), ...);
+    }
+    template <class T> void dynamic(const T& value) {
+        if (!valid_)
+            return;
+        if constexpr (std::is_same_v<T, std::string>) {
+            add(value.capacity(), 1);
+            add(1, 1);
+        } else if constexpr (wire::PagedSequence<T>::value) {
+            value.visitStorageCapacity([&](std::size_t n, std::size_t width) { add(n, width); });
+            for (const auto& row : value) {
+                if (!valid_)
+                    break;
+                dynamic(row);
+            }
+        } else if constexpr (wire::Vector<T>::value) {
+            add(value.capacity(), sizeof(typename T::value_type));
+            for (const auto& row : value) {
+                if (!valid_)
+                    break;
+                dynamic(row);
+            }
+        } else if constexpr (wire::Optional<T>::value) {
+            if (value)
+                dynamic(*value);
+        } else if constexpr (wire::Variant<T>::value) {
+            std::visit([&](const auto& row) { dynamic(row); }, value);
+        } else if constexpr (std::is_same_v<T, core::Error> || wire::Shared<T>::value) {
+            // Error's private string capacities and arbitrary shared payload are not inspectable.
+            valid_ = false;
+        } else if constexpr (std::is_trivially_copyable_v<T>) {
+            static_cast<void>(value);
+        } else {
+            wire::fields(*this, value);
+        }
+    }
