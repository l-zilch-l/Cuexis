+TEST_CASE("R3c payload lease counts retired generations and refunds at last owner",
+          "[r3c-budget]") {
+    Fixture3 f;
+    expandTickFixture(f, 1536, 256);
+    auto made = detail::ExecutionKernel::prepare(f.configuration(), f.prepared());
+    REQUIRE(made);
+    auto writer = std::move(*made);
+    auto empty = writer->archive();
+    REQUIRE(writer->advance(Tick{904}));
+    auto oldest = writer->archive();
+    const auto first = detail::ExecutionKernel::tickPayloadBytes(oldest);
+    REQUIRE(first > 0);
+    std::vector<ReplayArchive> generations;
+    for (const auto h : {1104, 1304, 1504, 1704, 1904}) {
+        REQUIRE(writer->advance(Tick{h}));
+        generations.push_back(writer->archive());
+        CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) <=
+              detail::ExecutionKernel::tickPayloadLimit(empty));
+    }
+    const auto before = detail::ExecutionKernel::tickPayloadBytes(empty);
+    CHECK(before > first);
+    CHECK_FALSE(writer->setTickPayloadLimitForProbe(0));
+    writer.reset();
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == before);
+    generations.clear();
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == first);
+    oldest = empty;
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == 0);
+}
