+TEST_CASE("R3c seek fork shares preparation payload charges", "[r3c-budget]") {
+    Fixture3 f;
+    expandTickFixture(f, 1536, 256);
+    auto made = detail::ExecutionKernel::prepare(f.configuration(), f.prepared());
+    REQUIRE(made);
+    auto empty = (*made)->archive();
+    REQUIRE((*made)->advance(Tick{904}));
+    auto original = (*made)->archive();
+    const auto first = detail::ExecutionKernel::tickPayloadBytes(empty);
+    REQUIRE(first > 0);
+    const auto cut = replayCutAt(original, Tick{904});
+    auto branch = detail::ExecutionKernel::seekCandidate(original, Tick{904}, nullptr, &cut);
+    REQUIRE(branch);
+    REQUIRE((*branch)->advance(Tick{1104}));
+    auto later = (*branch)->archive();
+    const auto both = detail::ExecutionKernel::tickPayloadBytes(empty);
+    CHECK(both > first);
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(later) == both);
+    made->reset();
+    branch->reset();
+    original = empty;
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == both - first);
+    later = empty;
+    CHECK(detail::ExecutionKernel::tickPayloadBytes(empty) == 0);
+}
