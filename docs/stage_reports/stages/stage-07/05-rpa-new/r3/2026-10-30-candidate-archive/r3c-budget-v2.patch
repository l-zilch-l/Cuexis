+TEST_CASE("R3c capacity visit keeps entry storage alive during reentrant mutation",
+          "[r3c-budget]") {
+    detail::SharedSequence<int> values;
+    for (int i = 0; i < 130; ++i)
+        values.push_back(i);
+    auto saved = values;
+    std::vector<std::pair<std::size_t, std::size_t>> expected, actual;
+    saved.visitStorageCapacity([&](auto n, auto width) { expected.emplace_back(n, width); });
+    values.visitStorageCapacity([&](auto n, auto width) {
+        actual.emplace_back(n, width);
+        values.clear();
+        values.push_back(7);
+    });
+    CHECK(actual == expected);
+    CHECK(saved.size() == 130);
+    CHECK(saved[129] == 129);
+    CHECK(values.size() == 1);
+    CHECK(values[0] == 7);
+}
