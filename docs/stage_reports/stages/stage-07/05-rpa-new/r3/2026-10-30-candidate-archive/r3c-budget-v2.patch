+        : budget(std::move(owner)), bytes(count) {}
+    TickPayloadLease(TickPayloadLease&& other) noexcept
+        : budget(std::move(other.budget)), bytes(std::exchange(other.bytes, 0)) {}
+    TickPayloadLease(const TickPayloadLease&) = delete;
+    auto operator=(const TickPayloadLease&) -> TickPayloadLease& = delete;
+    ~TickPayloadLease() {
+        if (budget)
+            budget->live.fetch_sub(bytes, std::memory_order_relaxed);
+    }
+};
