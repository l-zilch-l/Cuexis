+                    [](const auto* d, const auto& wanted) {
+                        return std::pair{d->kind, std::string_view{d->name}} < wanted;
+                    });
+                require(found != definitions.end() && (*found)->kind == kind &&
+                            (*found)->name == name,
+                        "mergedDeclarations", "definition source is missing");
+                return sourceFor((*found)->stableId.sourceDocumentId);
+            }
+            const auto it = std::find_if(
