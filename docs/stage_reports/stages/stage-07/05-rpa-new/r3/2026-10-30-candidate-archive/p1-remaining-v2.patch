+    {
+        // Index only kinds that actually issue repeated queries. All pointers stay in this call.
+        const auto repeatedKind = [&](DeclarationKind kind) {
+            return (kind == DeclarationKind::resourceRecord && g.resources.size() > 1) ||
+                   (kind == DeclarationKind::solverProfile && g.solverProfiles.size() > 1) ||
+                   (kind == DeclarationKind::judgementDomain && g.judgementDomains.size() > 1);
+        };
+        std::vector<const MergedDeclaration*> definitions;
+        bool indexed = false;
+        if (g.resources.size() > 1 || g.solverProfiles.size() > 1 ||
+            g.judgementDomains.size() > 1) {
+            try {
+                for (const auto& d : g.mergedNamespace.declarations)
+                    if (repeatedKind(d.kind))
+                        definitions.push_back(&d);
+                std::sort(definitions.begin(), definitions.end(), [](const auto* l, const auto* r) {
+                    const auto left = std::tie(l->kind, l->name);
+                    const auto right = std::tie(r->kind, r->name);
+                    // Same-array pointer order preserves first match even for equivalent keys.
+                    return left < right || (left == right && l < r);
+                });
+                indexed = true;
+            } catch (const std::bad_alloc&) {
+                // Optional scratch failure leaves the original validated lookup path available.
+                std::vector<const MergedDeclaration*>{}.swap(definitions);
+            }
+        }
+        // Typed records without a separate source field are located by their merged declarations.
+        const auto definitionSource = [&](DeclarationKind kind,
+                                          std::string_view name) -> GameplaySourceDocument& {
+            if (indexed && repeatedKind(kind)) {
+                const auto key = std::pair{kind, name};
+                const auto found = std::lower_bound(
