{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuexis.dev/schemas/cuexis.cxc.v1.schema.json",
  "title": "Cuexis CXC Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "project", "entries", "requiredExtensions", "extensions"],
  "properties": {
    "format": { "const": "cuexis.cxc" },
    "version": { "const": 1 },
    "project": { "const": "cuexis.project.json" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65533,
      "items": { "$ref": "#/$defs/entry" }
    },
    "requiredExtensions": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/requiredExtension" }
    },
    "extensions": { "type": "object", "maxProperties": 256 }
  },
  "$defs": {
    "portableStableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteCount", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "requiredExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/portableStableId" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
