{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuexis.dev/schemas/cuexis.chart.simple.v1.schema.json",
  "title": "Cuexis Simple Chart v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "chartId",
    "metadata",
    "timing",
    "templates",
    "behaviors",
    "objects",
    "extensions"
  ],
  "properties": {
    "format": { "const": "cuexis.chart.simple" },
    "version": { "const": 1 },
    "chartId": { "$ref": "#/$defs/uuidV7" },
    "metadata": { "type": "object" },
    "timing": {
      "type": "object",
      "required": ["offsetMs", "bpm"],
      "properties": {
        "offsetMs": { "type": "number" },
        "bpm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "camera": { "$ref": "#/$defs/camera" },
    "templates": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": { "$ref": "#/$defs/simpleId" },
      "additionalProperties": { "$ref": "#/$defs/simpleTemplate" }
    },
    "behaviors": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": { "$ref": "#/$defs/simpleId" },
      "additionalProperties": { "$ref": "#/$defs/simpleBehavior" }
    },
    "objects": {
      "type": "object",
      "maxProperties": 100000,
      "propertyNames": { "$ref": "#/$defs/simpleId" },
      "additionalProperties": { "$ref": "#/$defs/simpleObject" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "simpleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotationDeg": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" }
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "mesh": { "type": "string", "pattern": "^asset:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
        "material": { "type": "string", "pattern": "^asset:[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" }
      }
    },
    "simpleFields": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["note", "element", "decoration"] },
        "parent": { "type": "string", "pattern": "^object:[a-z][a-z0-9._-]{0,127}$" },
        "template": { "type": "string", "pattern": "^template:[a-z][a-z0-9._-]{0,127}$" },
        "beat": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:/[1-9][0-9]*)?|[0-9]+\\.[0-9]+)$",
          "maxLength": 128
        },
        "transform": { "$ref": "#/$defs/transform" },
        "render": { "$ref": "#/$defs/render" },
        "behavior": { "type": "string", "pattern": "^behavior:[a-z][a-z0-9._-]{0,127}$" }
      }
    },
    "simpleTemplate": {
      "allOf": [
        { "$ref": "#/$defs/simpleFields" },
        {
          "not": {
            "anyOf": [
              { "required": ["parent"] },
              { "required": ["beat"] },
              { "required": ["template"] }
            ]
          }
        }
      ]
    },
    "simpleObject": { "$ref": "#/$defs/simpleFields" },
"camera": {
      "type": "object",
      "required": ["type", "fovY", "near", "far"],
      "properties": {
        "type": { "enum": ["perspective"] },
        "fovY": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 179 },
        "near": { "type": "number", "exclusiveMinimum": 0 },
        "far": { "type": "number", "exclusiveMinimum": 0 },
        "pitch": { "type": "number" },
        "yaw": { "type": "number" },
        "roll": { "type": "number" },
        "defaultTransform": {
          "type": "object",
          "required": ["position"],
          "properties": {
            "position": { "$ref": "#/$defs/vec3" }
          }
        }
      }
    },
    "simpleBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracks"],
      "properties": {
        "tracks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["property", "keys"],
            "properties": {
              "property": {
                "enum": ["transform.position.x", "transform.position.y",
                         "transform.position.z", "camera.fovY"]
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 65536,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["beat", "value"],
                  "properties": {
                    "beat": {
                      "type": "string",
                      "pattern": "^[+-]?(?:[0-9]+(?:/[1-9][0-9]*)?|[0-9]+\\.[0-9]+)$",
                      "maxLength": 128
                    },
                    "value": { "type": "number" },
                    "easing": { "enum": ["linear", "in_cubic", "out_cubic", "in_out_cubic"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
                }
              }
            }
          }
        }
      }
    }
  }
}
