{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cuexis.dev/schemas/cuexis.project.v1.schema.json",
  "title": "Cuexis Project Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "projectId",
    "assetRoots",
    "entry",
    "extensions"
  ],
  "properties": {
    "format": { "const": "cuexis.project" },
    "version": { "const": 1 },
    "projectId": { "$ref": "#/definitions/uuidV7" },
    "assetRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/assetRoot" },
      "uniqueItems": true
    },
    "entry": { "$ref": "#/definitions/entry" },
    "extensions": {
      "type": "object",
      "maxProperties": 256
    }
  },
  "definitions": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "rootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "assetRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/definitions/rootId" },
        "path": { "$ref": "#/definitions/portablePath" }
      }
    },
    "bootstrapLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": { "$ref": "#/definitions/rootId" },
        "path": { "$ref": "#/definitions/portablePath" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart"],
      "properties": {
        "chart": { "$ref": "#/definitions/bootstrapLocator" }
      }
    }
  }
}
