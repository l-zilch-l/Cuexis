{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cuexis.gameplay-inline.t4-k4.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "chartId",
    "features",
    "timing",
    "defaultCamera",
    "resourceClosure",
    "entities",
    "requiredExtensions",
    "gameplay"
  ],
  "properties": {
    "format": {
      "const": "cuexis.chart"
    },
    "version": {
      "const": 5
    },
    "chartId": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offsetMs",
        "defaultBpm",
        "tempoEvents",
        "stops"
      ],
      "properties": {
        "offsetMs": {
          "type": "number"
        },
        "defaultBpm": {
          "type": "number"
        },
        "tempoEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startBeat",
              "durationBeats",
              "startBpm",
              "endBpm",
              "startSlope",
              "endSlope"
            ],
            "properties": {
              "startBeat": {
                "$ref": "#/definitions/Q"
              },
              "durationBeats": {
                "$ref": "#/definitions/Q"
              },
              "startBpm": {
                "type": "number"
              },
              "endBpm": {
                "type": "number"
              },
              "startSlope": {
                "type": "number"
              },
              "endSlope": {
                "type": "number"
              }
            }
          }
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "beat",
              "durationMs"
            ],
            "properties": {
              "beat": {
                "$ref": "#/definitions/Q"
              },
              "durationMs": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "defaultCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fovY",
        "nearPlane",
        "farPlane",
        "pitch",
        "yaw",
        "roll"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "fovY": {
          "type": "number"
        },
        "nearPlane": {
          "type": "number"
        },
        "farPlane": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        },
        "roll": {
          "type": "number"
        },
        "defaultTransform": {
          "$ref": "#/definitions/Transform"
        }
      }
    },
    "resourceClosure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "use"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "string",
            "enum": [
              "mainMusic",
              "renderableMesh",
              "renderableMaterial"
            ]
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "components",
          "requirements"
        ],
        "properties": {
          "identity": {
            "$ref": "#/definitions/EntityIdentity"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Component"
            }
          },
          "requirements": {
            "type": "array",
            "maxItems": 0
          },
          "parent": {
            "$ref": "#/definitions/EntityIdentity"
          }
        }
      }
    },
    "requiredExtensions": {
      "const": [
        "cuexis.gameplay.v2"
      ]
    },
    "gameplay": {
      "$ref": "#/definitions/Payload"
    },
    "mainMusic": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "Q": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "denominator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "not": {
            "const": "0"
          }
        }
      }
    },
    "StableId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentId",
        "declarationOrdinal"
      ],
      "properties": {
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "declarationOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "declarationOrdinal"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tap",
            "head",
            "body",
            "tail"
          ]
        },
        "declarationOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chartEntryId",
        "invocationId",
        "moduleId",
        "exportId",
        "requirementLocalId",
        "emissionPath"
      ],
      "properties": {
        "chartEntryId": {
          "type": "string",
          "minLength": 1
        },
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "exportId": {
          "type": "string",
          "minLength": 1
        },
        "requirementLocalId": {
          "type": "string",
          "minLength": 1
        },
        "emissionPath": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "repeatIndex"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "repeatIndex": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 20
              }
            }
          }
        }
      }
    },
    "RequiredRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "capabilities"
      ],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId"
            ],
            "properties": {
              "capabilityId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "Node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "operands",
            "atomRef"
          ],
          "properties": {
            "primitive": {
              "const": "atom"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node"
              },
              "maxItems": 0
            },
            "atomRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "operands"
          ],
          "properties": {
            "primitive": {
              "type": "string",
              "enum": [
                "sequence",
                "choice",
                "complement",
                "skip",
                "instant"
              ]
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "operands",
            "repeatBounds"
          ],
          "properties": {
            "primitive": {
              "const": "boundedRepeat"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node"
              }
            },
            "repeatBounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 20
                },
                "maximum": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 20
                }
              }
            }
          }
        }
      ]
    },
    "Pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchPolicy",
        "root",
        "requiredRefs"
      ],
      "properties": {
        "matchPolicy": {
          "const": "leftmost-first"
        },
        "root": {
          "$ref": "#/definitions/Node"
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        },
        "patternId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "requiredRefs"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "categoryToken",
              "gradeTokens"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "tap",
                  "head",
                  "body",
                  "tail"
                ]
              },
              "categoryToken": {
                "type": "string"
              },
              "gradeTokens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Grace": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "allowChartGrace"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "explicit",
                "default"
              ]
            },
            "allowChartGrace": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "allowChartGrace",
            "inheritedFromDeclarationId"
          ],
          "properties": {
            "policy": {
              "const": "inherited"
            },
            "allowChartGrace": {
              "type": "boolean"
            },
            "inheritedFromDeclarationId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "GraceInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitInTicks",
        "minimumCanonical",
        "maximumCanonical"
      ],
      "properties": {
        "unitInTicks": {
          "$ref": "#/definitions/Q"
        },
        "minimumCanonical": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "maximumCanonical": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "chartDuration": {
          "$ref": "#/definitions/Q"
        },
        "inheritedDuration": {
          "$ref": "#/definitions/Q"
        },
        "defaultDuration": {
          "$ref": "#/definitions/Q"
        }
      }
    },
    "Timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end",
        "successWindows",
        "phaseTargets"
      ],
      "properties": {
        "end": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "successWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "start",
              "end"
            ],
            "properties": {
              "phase": {
                "$ref": "#/definitions/Phase"
              },
              "start": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                "maxLength": 20
              },
              "end": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                "maxLength": 20
              }
            }
          }
        },
        "phaseTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "chartTick"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "tap",
                  "head",
                  "body",
                  "tail"
                ]
              },
              "chartTick": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                "maxLength": 20
              }
            }
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            },
            "end": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        }
      }
    },
    "AtomBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomRef",
        "domainToken",
        "sourceClass",
        "channelToken",
        "action",
        "tailOnly"
      ],
      "properties": {
        "atomRef": {
          "type": "string",
          "minLength": 1
        },
        "domainToken": {
          "type": "string",
          "minLength": 1
        },
        "sourceClass": {
          "type": "string",
          "minLength": 1
        },
        "channelToken": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "press",
            "release",
            "update"
          ]
        },
        "tailOnly": {
          "type": "boolean"
        },
        "amountRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            },
            "maximum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        }
      }
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "identity",
        "requiredActions",
        "domainBinding",
        "judgementDomainId",
        "phases",
        "requiresReleaseTailSemantics",
        "pattern",
        "patternArmRefs",
        "maxArmElements",
        "maxDeadlineElements",
        "measure",
        "resourceClaims",
        "grace",
        "timing",
        "atomBindings",
        "solverProfileRef",
        "localClosePolicyToken",
        "factBindingRefs",
        "requiredRefs"
      ],
      "properties": {
        "stableId": {
          "$ref": "#/definitions/StableId"
        },
        "identity": {
          "$ref": "#/definitions/Identity"
        },
        "requiredActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domainBinding": {
          "type": "string",
          "minLength": 1
        },
        "judgementDomainId": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Phase"
          }
        },
        "requiresReleaseTailSemantics": {
          "type": "boolean"
        },
        "pattern": {
          "$ref": "#/definitions/Pattern"
        },
        "patternArmRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxArmElements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        },
        "maxDeadlineElements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        },
        "measure": {
          "$ref": "#/definitions/Measure"
        },
        "resourceClaims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resourceId",
              "intent",
              "policyToken",
              "graceOverride"
            ],
            "properties": {
              "resourceId": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "enum": [
                  "observe",
                  "consume",
                  "claim"
                ]
              },
              "policyToken": {
                "type": "string",
                "minLength": 1
              },
              "graceOverride": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "overrideToken"
                ],
                "properties": {
                  "mode": {
                    "const": "none"
                  },
                  "overrideToken": {
                    "const": ""
                  }
                }
              }
            }
          },
          "maxItems": 1
        },
        "grace": {
          "$ref": "#/definitions/Grace"
        },
        "timing": {
          "$ref": "#/definitions/Timing"
        },
        "atomBindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AtomBinding"
          }
        },
        "solverProfileRef": {
          "type": "string",
          "minLength": 1
        },
        "localClosePolicyToken": {
          "type": "string",
          "minLength": 1
        },
        "factBindingRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "kind",
        "localName",
        "references",
        "requiredRefs"
      ],
      "properties": {
        "stableId": {
          "$ref": "#/definitions/StableId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "requirement",
            "patternDefinition",
            "measureDefinition",
            "resourceRecord",
            "judgementDomain",
            "solverProfile"
          ]
        },
        "localName": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "declarationOrdinal"
                ],
                "properties": {
                  "scope": {
                    "const": "sameDocument"
                  },
                  "declarationOrdinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "sourceDocumentId",
                  "declarationOrdinal"
                ],
                "properties": {
                  "scope": {
                    "const": "explicitCrossDocument"
                  },
                  "sourceDocumentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "declarationOrdinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              }
            ]
          }
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "declaredCapacity",
        "slotToken",
        "decisionPolicyRef",
        "terminalAfterTermination",
        "declaredGapGrace",
        "requiredRefs"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "declaredCapacity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "slotToken": {
          "type": "string",
          "minLength": 1
        },
        "decisionPolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "terminalAfterTermination": {
          "type": "boolean"
        },
        "declaredGapGrace": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
