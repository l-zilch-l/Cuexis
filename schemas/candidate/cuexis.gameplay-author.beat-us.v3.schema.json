{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cuexis.gameplay-author.beat-us.v3",
  "title": "Private candidate Gameplay beat-us v3 author payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authorProfile",
    "sourceDocumentId",
    "common",
    "requirements",
    "rankAssignment"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "authorProfile": {
      "const": "gameplay.author.beat-us.v1"
    },
    "sourceDocumentId": {
      "type": "string",
      "minLength": 1
    },
    "common": {
      "$ref": "#/definitions/Common"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Requirement"
      }
    },
    "rankAssignment": {
      "$ref": "#/definitions/RankAssignment"
    }
  },
  "definitions": {
    "Q": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "denominator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "not": {
            "const": "0"
          }
        }
      }
    },
    "StableId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentId",
        "declarationOrdinal"
      ],
      "properties": {
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "declarationOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "declarationOrdinal"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tap",
            "head",
            "body",
            "tail"
          ]
        },
        "declarationOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chartEntryId",
        "invocationId",
        "moduleId",
        "exportId",
        "requirementLocalId",
        "emissionPath"
      ],
      "properties": {
        "chartEntryId": {
          "type": "string",
          "minLength": 1
        },
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "exportId": {
          "type": "string",
          "minLength": 1
        },
        "requirementLocalId": {
          "type": "string",
          "minLength": 1
        },
        "emissionPath": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "repeatIndex"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "repeatIndex": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 20
              }
            }
          }
        }
      }
    },
    "RequiredRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "capabilities"
      ],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId"
            ],
            "properties": {
              "capabilityId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "Node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "operands",
            "atomRef"
          ],
          "properties": {
            "primitive": {
              "const": "atom"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node"
              },
              "maxItems": 0
            },
            "atomRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "operands"
          ],
          "properties": {
            "primitive": {
              "type": "string",
              "enum": [
                "sequence",
                "choice",
                "complement",
                "skip",
                "instant"
              ]
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "operands",
            "repeatBounds"
          ],
          "properties": {
            "primitive": {
              "const": "boundedRepeat"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Node"
              }
            },
            "repeatBounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 20
                },
                "maximum": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 20
                }
              }
            }
          }
        }
      ]
    },
    "Pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchPolicy",
        "root",
        "requiredRefs"
      ],
      "properties": {
        "matchPolicy": {
          "const": "leftmost-first"
        },
        "root": {
          "$ref": "#/definitions/Node"
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        },
        "patternId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Grace": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "allowChartGrace"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "explicit",
                "default"
              ]
            },
            "allowChartGrace": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "allowChartGrace",
            "inheritedFromDeclarationId"
          ],
          "properties": {
            "policy": {
              "const": "inherited"
            },
            "allowChartGrace": {
              "type": "boolean"
            },
            "inheritedFromDeclarationId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "GraceInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitInTicks",
        "minimumCanonical",
        "maximumCanonical"
      ],
      "properties": {
        "unitInTicks": {
          "$ref": "#/definitions/Q"
        },
        "minimumCanonical": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "maximumCanonical": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "chartDuration": {
          "$ref": "#/definitions/Q"
        },
        "inheritedDuration": {
          "$ref": "#/definitions/Q"
        },
        "defaultDuration": {
          "$ref": "#/definitions/Q"
        }
      }
    },
    "AtomBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomRef",
        "domainToken",
        "sourceClass",
        "channelToken",
        "action",
        "tailOnly"
      ],
      "properties": {
        "atomRef": {
          "type": "string",
          "minLength": 1
        },
        "domainToken": {
          "type": "string",
          "minLength": 1
        },
        "sourceClass": {
          "type": "string",
          "minLength": 1
        },
        "channelToken": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "press",
            "release",
            "update"
          ]
        },
        "tailOnly": {
          "type": "boolean"
        },
        "amountRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            },
            "maximum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        }
      }
    },
    "Declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "kind",
        "localName",
        "references",
        "requiredRefs"
      ],
      "properties": {
        "stableId": {
          "$ref": "#/definitions/StableId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "requirement",
            "patternDefinition",
            "measureDefinition",
            "resourceRecord",
            "judgementDomain",
            "solverProfile"
          ]
        },
        "localName": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "declarationOrdinal"
                ],
                "properties": {
                  "scope": {
                    "const": "sameDocument"
                  },
                  "declarationOrdinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "sourceDocumentId",
                  "declarationOrdinal"
                ],
                "properties": {
                  "scope": {
                    "const": "explicitCrossDocument"
                  },
                  "sourceDocumentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "declarationOrdinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              }
            ]
          }
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "declaredCapacity",
        "slotToken",
        "decisionPolicyRef",
        "terminalAfterTermination",
        "declaredGapGrace",
        "requiredRefs"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "declaredCapacity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "slotToken": {
          "type": "string",
          "minLength": 1
        },
        "decisionPolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "terminalAfterTermination": {
          "type": "boolean"
        },
        "declaredGapGrace": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
          "maxLength": 20
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resourceId",
        "members",
        "policyToken",
        "declaredCapacity",
        "requiredRefs"
      ],
      "properties": {
        "kind": {
          "const": "exclusive"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StableId"
          }
        },
        "policyToken": {
          "type": "string",
          "minLength": 1
        },
        "declaredCapacity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solverId",
        "revision",
        "algorithmToken",
        "objective",
        "tieBreak",
        "rejectIfNonUnique",
        "requiredRefs"
      ],
      "properties": {
        "solverId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "algorithmToken": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tieBreak": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejectIfNonUnique": {
          "type": "boolean"
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "coordinateSystemToken",
        "axes",
        "frame",
        "requiredRefs"
      ],
      "properties": {
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "coordinateSystemToken": {
          "type": "string",
          "minLength": 1
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "axisToken",
              "minimum",
              "maximum"
            ],
            "properties": {
              "axisToken": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                "maxLength": 20
              },
              "maximum": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                "maxLength": 20
              }
            }
          }
        },
        "frame": {
          "const": "static"
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "Late": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "finalizationWatermark",
        "maxQueueHop",
        "windowCloseThreshold",
        "windowOpenThreshold"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "reject_late",
            "queue_next_tick"
          ]
        },
        "finalizationWatermark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        },
        "maxQueueHop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        },
        "windowCloseThreshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        },
        "windowOpenThreshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "measured"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
              "maxLength": 20
            }
          }
        }
      }
    },
    "MeasureDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration"
      ],
      "properties": {
        "declaration": {
          "$ref": "#/definitions/Measure"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RankAssignment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rows"
          ],
          "properties": {
            "mode": {
              "const": "explicit"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "priority",
                  "tieRank",
                  "namespace"
                ],
                "properties": {
                  "identity": {
                    "$ref": "#/definitions/Identity"
                  },
                  "priority": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                    "maxLength": 20
                  },
                  "tieRank": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "maxLength": 20
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "blocks"
          ],
          "properties": {
            "mode": {
              "const": "affine"
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "invocationId",
                  "moduleId",
                  "exportId",
                  "requirementLocalId",
                  "namespace",
                  "priority",
                  "base",
                  "stride",
                  "nodeOrder",
                  "radices"
                ],
                "properties": {
                  "invocationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "moduleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exportId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requirementLocalId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$",
                    "maxLength": 20
                  },
                  "base": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "maxLength": 20
                  },
                  "stride": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "maxLength": 20,
                    "not": {
                      "const": "0"
                    }
                  },
                  "nodeOrder": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "radices": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$",
                      "maxLength": 20
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "PhaseKind": {
      "type": "string",
      "enum": [
        "tap",
        "head",
        "body",
        "tail"
      ]
    },
    "Beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "Measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "requiredRefs"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "categoryToken",
              "gradeTokens"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "tap",
                  "head",
                  "body",
                  "tail"
                ]
              },
              "categoryToken": {
                "type": "string"
              },
              "gradeTokens": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        "requiredRefs": {
          "$ref": "#/definitions/RequiredRefs"
        }
      }
    },
    "GradeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "gradeTable"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "tap",
            "head",
            "body",
            "tail"
          ]
        },
        "gradeTable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
        }
      }
    },
    "ScoreSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "unit"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "enum": [
                "tap",
                "head",
                "body",
                "tail"
              ]
            },
            "unit": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
