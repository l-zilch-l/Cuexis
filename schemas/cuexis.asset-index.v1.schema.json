{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cuexis.dev/schemas/cuexis.asset-index.v1.schema.json",
  "title": "Cuexis Asset Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "assets",
    "extensions"
  ],
  "properties": {
    "format": { "const": "cuexis.asset-index" },
    "version": { "const": 1 },
    "assets": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/definitions/assetRecord" },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "maxProperties": 256
    }
  },
  "definitions": {
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "assetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "dependencies"],
      "properties": {
        "id": { "$ref": "#/definitions/assetId" },
        "type": { "enum": ["mesh", "material", "texture"] },
        "source": { "$ref": "#/definitions/portablePath" },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/definitions/assetId" },
          "uniqueItems": true
        },
        "extensions": {
          "type": "object",
          "maxProperties": 256
        }
      }
    }
  }
}
