# Section 7 N05 budgets: a command file over the 1 MiB limit is refused before
# any line is interpreted. The input is generated by the runner, so only the
# expectation lives here.
#
# The step is pinned to "parse": every limit that is a property of the program
# text - its size, its command count, its tick budget, its chart-time range - is
# a parser decision. "file" is reserved for IO failures.
exit fail
code host.command.limit_exceeded
diagnostic-step parse
absent host.load
absent host.frame
# The bare substring "host.command" is present in the required
# host.diagnostic code, so absence has to be expressed against a line shape
# that only a dispatched command produces.
absent host.command index=
