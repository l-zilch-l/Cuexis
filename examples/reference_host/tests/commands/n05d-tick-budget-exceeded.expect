# n05d-tick-budget-exceeded: section 7 N05 (H6) - 100000 + 1 exceeds the cumulative budget
exit fail
code host.command.limit_exceeded
diagnostic-step parse
absent host.load
absent host.frame
# NOTE: a bare 'absent host.command' cannot hold, because the required diagnostic code contains
# that substring; absence of a dispatched command is expressed as 'absent host.command index='.
# This case does not need that stronger form.
