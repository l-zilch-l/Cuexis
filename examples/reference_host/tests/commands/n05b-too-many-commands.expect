# Section 7 N05 budgets: more than 10000 commands in one program is refused at
# the parse layer. The input is generated by the runner, and each line is a real
# verb so that the command count, and not the file size, is the boundary under
# test.
exit fail
code host.command.limit_exceeded
diagnostic-step parse
absent host.load
absent host.frame
# The bare substring "host.command" is present in the required
# host.diagnostic code, so absence has to be expressed against a line shape
# that only a dispatched command produces.
absent host.command index=
