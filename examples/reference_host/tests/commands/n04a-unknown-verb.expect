# n04a-unknown-verb: section 7 N04 (H6) - unknown verb, rejected before any SDK load
exit fail
code host.command.unknown_verb
diagnostic-step parse
absent host.load
absent host.frame
# NOTE: a bare 'absent host.command' cannot hold, because the required diagnostic code
# contains that substring; the indexed form 'absent host.command index=' can express it and is
# used by n05a, n05b and n07a. This case does not need it.
