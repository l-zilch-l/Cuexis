{
  "name": "cuexis",
  "version-string": "26.08.01-1",
  "default-features": [
    "player",
    "tests"
  ],
  "dependencies": [
    "entt",
    "glm",
    "json-schema-validator",
    {
      "name": "minizip-ng",
      "default-features": false
    },
    "nlohmann-json",
    "tl-expected"
  ],
  "features": {
    "audio-sdl": {
      "description": "Build dependencies for the optional SDL audio adapter",
      "dependencies": [
        "sdl3"
      ]
    },
    "player": {
      "description": "Build dependencies for the SDL/OpenGL Cuexis Player",
      "dependencies": [
        "glad",
        "sdl3",
        "spdlog"
      ]
    },
    "tests": {
      "description": "Catch2 dependency for Cuexis test targets",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
