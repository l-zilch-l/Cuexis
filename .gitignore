/.idea/
/.vs/
/.codex/
/cmake-build-*/
/out/
/vcpkg_installed/

CMakeUserPresets.json
*.user
*.VC.db
*.VC.VC.opendb

# Local toolchain shims. These hard-code one machine's Visual Studio, Windows SDK
# and vcpkg locations, so they are wrong everywhere else; each developer keeps
# their own. Same reasoning as CMakeUserPresets.json above.
/.buildenv.ps1

# Agent/tooling scratch space, never repository content.
/.workbuddy/

# DSH project-scoped skills. The ai-link bridge writes its ask-codex skill here,
# and the rendered file hard-codes one machine's install path, so it is not
# repository content. Each developer installs their own copy.
/.dsh/

# Compiler object files (MSVC .obj pick up the same name on every platform).
*.obj
