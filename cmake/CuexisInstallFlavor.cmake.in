set(cuexis_flavor_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(cuexis_flavor_stamp "${cuexis_flavor_root}/share/cuexis/build-flavor.txt")
if(EXISTS "${cuexis_flavor_stamp}")
    file(READ "${cuexis_flavor_stamp}" cuexis_existing_flavor)
    string(STRIP "${cuexis_existing_flavor}" cuexis_existing_flavor)
    if(NOT cuexis_existing_flavor STREQUAL "@CUEXIS_BUILD_FLAVOR@")
        message(FATAL_ERROR "Cuexis production and experimental install prefixes cannot be mixed")
    endif()
else()
    file(GLOB_RECURSE cuexis_unmarked_configs
        "${cuexis_flavor_root}/*CuexisConfig.cmake")
    if(cuexis_unmarked_configs OR EXISTS "${cuexis_flavor_root}/include/cuexis/playback/playback_session.hpp")
        message(FATAL_ERROR "Cuexis unmarked existing install prefix must be staged into a clean directory")
    endif()
endif()
file(MAKE_DIRECTORY "${cuexis_flavor_root}/share/cuexis")
file(WRITE "${cuexis_flavor_stamp}" "@CUEXIS_BUILD_FLAVOR@\n")
