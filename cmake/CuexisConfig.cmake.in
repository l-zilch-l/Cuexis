@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(tl-expected CONFIG)
find_dependency(glm CONFIG)
find_dependency(EnTT CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(nlohmann_json_schema_validator CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/CuexisTargets.cmake")

set(Cuexis_VERSION "@CUEXIS_SDK_API_VERSION@")
set(Cuexis_API_VERSION "@CUEXIS_SDK_API_VERSION@")
set(Cuexis_VERSION_DISPLAY "@CUEXIS_VERSION_DISPLAY@")
set(Cuexis_Playback_FOUND TRUE)
set(Cuexis_Content_FOUND TRUE)

foreach(component IN LISTS Cuexis_FIND_COMPONENTS)
    if(NOT component STREQUAL "Playback" AND NOT component STREQUAL "Content")
        set(Cuexis_${component}_FOUND FALSE)
        set(Cuexis_NOT_FOUND_MESSAGE "Unsupported Cuexis component: ${component}")
    endif()
endforeach()

check_required_components(Cuexis)
