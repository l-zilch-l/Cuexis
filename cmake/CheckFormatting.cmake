# Bound each invocation so growing source lists do not exceed Windows process limits.
if(NOT EXISTS "${CUEXIS_CLANG_FORMAT_EXECUTABLE}" OR
   NOT EXISTS "${CUEXIS_FORMAT_FILE_LIST}")
    message(FATAL_ERROR "Formatting requires an executable and a source file list")
endif()
file(STRINGS "${CUEXIS_FORMAT_FILE_LIST}" format_files ENCODING UTF-8)
list(LENGTH format_files remaining)
set(format_failed FALSE)
while(remaining GREATER 0)
    list(SUBLIST format_files 0 20 batch)
    execute_process(COMMAND "${CUEXIS_CLANG_FORMAT_EXECUTABLE}" --dry-run --Werror ${batch}
        RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "0")
        set(format_failed TRUE)
    endif()
    if(remaining GREATER 20)
        list(SUBLIST format_files 20 -1 format_files)
    else()
        set(format_files "")
    endif()
    list(LENGTH format_files remaining)
endwhile()
if(format_failed)
    message(FATAL_ERROR "Formatting check failed")
endif()
